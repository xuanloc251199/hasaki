@startuml sq-36-dathang
title Biểu đồ tuần tự - Đặt hàng / Thanh toán
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Khách hàng" as U
participant "CheckoutView" as V
participant "InvoiceBLL" as B
participant "InvoiceDAL" as ID
participant "ProductDAL" as PD
database "CSDL" as DB
U -> V : Nhập thông tin giao hàng + chọn TT
activate V
U -> V : Nhấn "Đặt hàng"
V -> B : checkout(maKH, info, items)
activate B
alt Giỏ trống / thiếu thông tin
  B --> V : {error}
  V --> U : Thông báo lỗi
else Hợp lệ
  B -> B : Tính tổng tiền
  B -> ID : create(hoaDon, chiTiet)
  ID -> DB : BEGIN; INSERT HoaDonBan + ChiTiet; COMMIT
  DB --> ID : MaHoaDon
  ID --> B : MaHoaDon
  loop mỗi sản phẩm
    B -> PD : decreaseStock(id, sl)
    PD -> DB : UPDATE SanPham SET SoLuong-=?
  end
  B --> V : {success}
  V -> V : Xóa giỏ hàng
  V --> U : Trang "Đặt hàng thành công"
end
deactivate B
deactivate V
@enduml
