@startuml sq-48-delete-sanpham
title Biểu đồ tuần tự - Xóa sản phẩm
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/products.php" as V
participant "ProductBLL" as B
participant "ProductDAL" as D
database "CSDL" as DB
U -> V : Chọn xóa sản phẩm
activate V
V --> U : "Bạn có chắc chắn muốn xóa sản phẩm này không?"
alt Người dùng chọn Có
  U -> V : Đồng ý
  V -> B : delete(id)
  activate B
  B -> D : delete(id)
  D -> DB : DELETE sản phẩm WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : Cập nhật danh sách
  deactivate B
else Người dùng chọn Không
  V --> U : Đóng thông báo
end
deactivate V

@enduml
