@startuml sq-70-manage-taikhoan
title Biểu đồ tuần tự - Quản lý tài khoản
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/accounts.php" as V
participant "AccountBLL" as B
participant "AccountDAL" as D
database "CSDL" as DB
U -> V : Chọn chức năng quản lý tài khoản
activate V
V -> B : getAll()
activate B
B -> D : getAll()
D -> DB : SELECT danh sách tài khoản
DB --> D : dữ liệu
D --> B : danh sách
B --> V : danh sách
deactivate B
V --> U : Hiển thị danh sách tài khoản
deactivate V

@enduml
