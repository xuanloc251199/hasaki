@startuml uc-a05-taikhoan
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý tài khoản (UC05)
actor "Admin" as ACT0
rectangle "Quản lý tài khoản" {
  usecase "Thêm tài khoản" as U0
  usecase "Sửa tài khoản" as U1
  usecase "Xóa tài khoản" as U2
  usecase "Khóa/Mở tài khoản" as U3
  usecase "Tìm kiếm tài khoản" as U4
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
ACT0 -- U4
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
U4 ..> LOGIN : <<include>>
@enduml
