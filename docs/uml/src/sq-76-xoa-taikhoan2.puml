@startuml sq-76-xoa-taikhoan2
title Biểu đồ tuần tự - Xóa tài khoản
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/accounts.php" as V
participant "AccountBLL" as B
participant "AccountDAL" as D
database "CSDL" as DB
U -> V : Chọn xóa tài khoản
activate V
V --> U : "Bạn có chắc chắn muốn xóa tài khoản này không?"
alt Người dùng chọn Có
  U -> V : Đồng ý
  V -> B : delete(id)
  activate B
  B -> D : delete(id)
  D -> DB : DELETE tài khoản WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : Cập nhật danh sách
  deactivate B
else Người dùng chọn Không
  V --> U : Đóng thông báo
end
deactivate V

@enduml
