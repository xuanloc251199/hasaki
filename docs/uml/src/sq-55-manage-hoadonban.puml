@startuml sq-55-manage-hoadonban
title Biểu đồ tuần tự - Quản lý hóa đơn bán
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/invoices.php" as V
participant "InvoiceBLL" as B
participant "InvoiceDAL" as D
database "CSDL" as DB
U -> V : Chọn chức năng quản lý hóa đơn bán
activate V
V -> B : getAll()
activate B
B -> D : getAll()
D -> DB : SELECT danh sách hóa đơn bán
DB --> D : dữ liệu
D --> B : danh sách
B --> V : danh sách
deactivate B
V --> U : Hiển thị danh sách hóa đơn bán
deactivate V

@enduml
