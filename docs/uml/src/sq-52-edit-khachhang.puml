@startuml sq-52-edit-khachhang
title Biểu đồ tuần tự - Sửa khách hàng
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/customers.php" as V
participant "CustomerBLL" as B
participant "CustomerDAL" as D
database "CSDL" as DB
U -> V : Chọn khách hàng cần sửa, nhập thông tin mới
activate V
V -> B : update(id, data)
activate B
B -> B : Kiểm tra dữ liệu
alt Dữ liệu hợp lệ
  B -> D : update(id, data)
  D -> DB : UPDATE khách hàng SET ... WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : "Sửa khách hàng thành công"
else Không hợp lệ
  B --> V : lỗi
  V --> U : "Thông tin không hợp lệ"
end
deactivate B
deactivate V

@enduml
