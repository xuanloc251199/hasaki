@startuml sq-30-dangnhap
title Biểu đồ tuần tự - Đăng nhập
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Người dùng" as U
participant "LoginView" as V
participant "AuthBLL" as B
participant "AccountDAL" as D
database "CSDL" as DB
U -> V : Nhập tên đăng nhập, mật khẩu
activate V
V -> V : Kiểm tra CSRF
V -> B : login(user, pass)
activate B
B -> D : findByUsername(user)
D -> DB : SELECT TaiKhoan WHERE TenTaiKhoan=?
DB --> D : bản ghi
D --> B : tài khoản
B -> B : password_verify()
alt Hợp lệ
  B --> V : thành công
  V -> V : Khởi tạo session
  V --> U : Vào trang chủ / dashboard
else Sai thông tin
  B --> V : false
  V --> U : "Sai tài khoản hoặc mật khẩu"
end
deactivate B
deactivate V
@enduml
