@startuml sq-60-manage-hoadonnhap
title Biểu đồ tuần tự - Quản lý hóa đơn nhập
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/import-invoices.php" as V
participant "ImportInvoiceBLL" as B
participant "ImportInvoiceDAL" as D
database "CSDL" as DB
U -> V : Chọn chức năng quản lý hóa đơn nhập
activate V
V -> B : getAll()
activate B
B -> D : getAll()
D -> DB : SELECT danh sách hóa đơn nhập
DB --> D : dữ liệu
D --> B : danh sách
B --> V : danh sách
deactivate B
V --> U : Hiển thị danh sách hóa đơn nhập
deactivate V

@enduml
