actor "Khách hàng" as ACT0
rectangle "Xem sản phẩm" {
  usecase "Xem danh sách sản phẩm" as U0
  usecase "Xem chi tiết sản phẩm" as U1
  usecase "Lọc theo danh mục" as U2
  usecase "Xem đánh giá" as U3
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
