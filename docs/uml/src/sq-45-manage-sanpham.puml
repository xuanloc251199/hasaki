@startuml sq-45-manage-sanpham
title Biểu đồ tuần tự - Quản lý sản phẩm
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/products.php" as V
participant "ProductBLL" as B
participant "ProductDAL" as D
database "CSDL" as DB
U -> V : Chọn chức năng quản lý sản phẩm
activate V
V -> B : getAll()
activate B
B -> D : getAll()
D -> DB : SELECT danh sách sản phẩm
DB --> D : dữ liệu
D --> B : danh sách
B --> V : danh sách
deactivate B
V --> U : Hiển thị danh sách sản phẩm
deactivate V

@enduml
