@startuml sq-35-xoa-giohang
title Biểu đồ tuần tự - Xóa sản phẩm trong giỏ
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Khách hàng" as U
participant "CartView" as V
participant "CartBLL" as B
participant "Session" as S
U -> V : Chọn xóa sản phẩm
activate V
V --> U : "Bạn có chắc muốn xóa?"
U -> V : Đồng ý
V -> B : remove(id)
activate B
B -> S : unset($_SESSION[cart][id])
B --> V : giỏ sau khi xóa
deactivate B
V --> U : Cập nhật giỏ hàng
deactivate V
@enduml
