@startuml sq-63-delete-hoadonnhap
title Biểu đồ tuần tự - Xóa hóa đơn nhập
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/import-invoices.php" as V
participant "ImportInvoiceBLL" as B
participant "ImportInvoiceDAL" as D
database "CSDL" as DB
U -> V : Chọn xóa hóa đơn nhập
activate V
V --> U : "Bạn có chắc chắn muốn xóa hóa đơn nhập này không?"
alt Người dùng chọn Có
  U -> V : Đồng ý
  V -> B : delete(id)
  activate B
  B -> D : delete(id)
  D -> DB : DELETE hóa đơn nhập WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : Cập nhật danh sách
  deactivate B
else Người dùng chọn Không
  V --> U : Đóng thông báo
end
deactivate V

@enduml
