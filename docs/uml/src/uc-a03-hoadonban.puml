@startuml uc-a03-hoadonban
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý hóa đơn bán (UC03)
actor "Nhân viên" as ACT0
rectangle "Quản lý hóa đơn bán" {
  usecase "Xem hóa đơn" as U0
  usecase "Cập nhật trạng thái" as U1
  usecase "Xóa hóa đơn" as U2
  usecase "Tìm kiếm hóa đơn" as U3
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
@enduml
