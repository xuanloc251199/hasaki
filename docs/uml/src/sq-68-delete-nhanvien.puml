@startuml sq-68-delete-nhanvien
title Biểu đồ tuần tự - Xóa nhân viên
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/employees.php" as V
participant "EmployeeBLL" as B
participant "EmployeeDAL" as D
database "CSDL" as DB
U -> V : Chọn xóa nhân viên
activate V
V --> U : "Bạn có chắc chắn muốn xóa nhân viên này không?"
alt Người dùng chọn Có
  U -> V : Đồng ý
  V -> B : delete(id)
  activate B
  B -> D : delete(id)
  D -> DB : DELETE nhân viên WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : Cập nhật danh sách
  deactivate B
else Người dùng chọn Không
  V --> U : Đóng thông báo
end
deactivate V

@enduml
