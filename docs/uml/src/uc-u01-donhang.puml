@startuml uc-u01-donhang
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý đơn hàng (UC01)
actor "Khách hàng" as ACT0
rectangle "Quản lý đơn hàng" {
  usecase "Xem danh sách đơn" as U0
  usecase "Xem chi tiết đơn" as U1
  usecase "In / Tải hóa đơn" as U2
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
@enduml
