@startuml sq-62-edit-hoadonnhap
title Biểu đồ tuần tự - Sửa hóa đơn nhập
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/import-invoices.php" as V
participant "ImportInvoiceBLL" as B
participant "ImportInvoiceDAL" as D
database "CSDL" as DB
U -> V : Chọn hóa đơn nhập cần sửa, nhập thông tin mới
activate V
V -> B : update(id, data)
activate B
B -> B : Kiểm tra dữ liệu
alt Dữ liệu hợp lệ
  B -> D : update(id, data)
  D -> DB : UPDATE hóa đơn nhập SET ... WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : "Sửa hóa đơn nhập thành công"
else Không hợp lệ
  B --> V : lỗi
  V --> U : "Thông tin không hợp lệ"
end
deactivate B
deactivate V

@enduml
