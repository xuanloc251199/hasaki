@startuml sq-57-edit-hoadonban
title Biểu đồ tuần tự - Sửa hóa đơn bán
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/invoices.php" as V
participant "InvoiceBLL" as B
participant "InvoiceDAL" as D
database "CSDL" as DB
U -> V : Chọn hóa đơn bán cần sửa, nhập thông tin mới
activate V
V -> B : update(id, data)
activate B
B -> B : Kiểm tra dữ liệu
alt Dữ liệu hợp lệ
  B -> D : update(id, data)
  D -> DB : UPDATE hóa đơn bán SET ... WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : "Sửa hóa đơn bán thành công"
else Không hợp lệ
  B --> V : lỗi
  V --> U : "Thông tin không hợp lệ"
end
deactivate B
deactivate V

@enduml
