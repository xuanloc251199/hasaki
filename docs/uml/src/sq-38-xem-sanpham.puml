@startuml sq-38-xem-sanpham
title Biểu đồ tuần tự - Xem thông tin sản phẩm
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Khách hàng" as U
participant "ProductDetailView" as V
participant "ProductBLL" as PB
participant "ReviewBLL" as RB
database "CSDL" as DB
U -> V : Mở trang chi tiết sản phẩm
activate V
V -> PB : getById(id)
PB -> DB : SELECT SanPham
DB --> PB : sản phẩm
PB --> V : sản phẩm
V -> RB : getByProduct(id)
RB -> DB : SELECT DanhGia
DB --> RB : đánh giá
RB --> V : danh sách + điểm TB
V -> PB : getRelated(id)
PB --> V : sản phẩm liên quan
V --> U : Hiển thị chi tiết + tab thông tin/đánh giá
deactivate V
@enduml
