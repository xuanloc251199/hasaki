@startuml uc-a07-khohang
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý kho hàng (UC07)
actor "Nhân viên" as ACT0
rectangle "Quản lý kho hàng" {
  usecase "Thêm vào kho" as U0
  usecase "Sửa tồn kho" as U1
  usecase "Xóa khỏi kho" as U2
  usecase "Xem kho" as U3
  usecase "Tìm kiếm" as U4
  usecase "Xuất kho" as U5
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
ACT0 -- U4
ACT0 -- U5
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
U4 ..> LOGIN : <<include>>
U5 ..> LOGIN : <<include>>
@enduml
