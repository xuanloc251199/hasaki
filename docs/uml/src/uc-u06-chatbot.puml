@startuml uc-u06-chatbot
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Trò chuyện với AI Chatbot (UC06)
actor "Khách hàng" as ACT0
rectangle "Trò chuyện với AI Chatbot" {
  usecase "Mở chatbot" as U0
  usecase "Gửi câu hỏi" as U1
  usecase "Chọn gợi ý nhanh" as U2
  usecase "Xem sản phẩm gợi ý" as U3
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
@enduml
