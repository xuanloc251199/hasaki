@startuml sq-79-chatbot
title Biểu đồ tuần tự - Trò chuyện với AI Chatbot
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Khách hàng" as U
participant "Chatbot Widget" as W
participant "chatbot.php" as API
participant "ChatbotBLL" as B
participant "ChatbotDAL" as CD
participant "ProductBLL" as PB
database "CSDL" as DB
U -> W : Nhập câu hỏi
activate W
W -> API : POST message
activate API
API -> B : reply(message)
activate B
B -> B : Chuẩn hóa (lowercase + khử dấu)
B -> CD : getActiveIntents()
CD -> DB : SELECT intent WHERE KichHoat=1
DB --> CD : intents
CD --> B : intents
B -> B : Khớp từ khóa
alt Có intent khớp
  B -> B : buildReply() + gắn sản phẩm
  B --> API : trả lời + sản phẩm
else Không khớp & fallback bật
  B -> PB : search(keywords)
  PB --> B : sản phẩm
  B --> API : sản phẩm liên quan
else Không tìm thấy
  B --> API : câu trả lời mặc định
end
deactivate B
API --> W : phản hồi (text + thẻ SP)
deactivate API
W --> U : Hiển thị câu trả lời
deactivate W
@enduml
