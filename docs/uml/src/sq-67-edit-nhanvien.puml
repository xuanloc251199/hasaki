@startuml sq-67-edit-nhanvien
title Biểu đồ tuần tự - Sửa nhân viên
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/employees.php" as V
participant "EmployeeBLL" as B
participant "EmployeeDAL" as D
database "CSDL" as DB
U -> V : Chọn nhân viên cần sửa, nhập thông tin mới
activate V
V -> B : update(id, data)
activate B
B -> B : Kiểm tra dữ liệu
alt Dữ liệu hợp lệ
  B -> D : update(id, data)
  D -> DB : UPDATE nhân viên SET ... WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : "Sửa nhân viên thành công"
else Không hợp lệ
  B --> V : lỗi
  V --> U : "Thông tin không hợp lệ"
end
deactivate B
deactivate V

@enduml
