@startuml uc-a06-nhanvien
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý nhân viên (UC06)
actor "Admin" as ACT0
rectangle "Quản lý nhân viên" {
  usecase "Thêm nhân viên" as U0
  usecase "Sửa nhân viên" as U1
  usecase "Xóa nhân viên" as U2
  usecase "Tìm kiếm nhân viên" as U3
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
@enduml
