@startuml sq-42-edit-danhmuc
title Biểu đồ tuần tự - Sửa danh mục
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/categories.php" as V
participant "CategoryBLL" as B
participant "CategoryDAL" as D
database "CSDL" as DB
U -> V : Chọn danh mục cần sửa, nhập thông tin mới
activate V
V -> B : update(id, data)
activate B
B -> B : Kiểm tra dữ liệu
alt Dữ liệu hợp lệ
  B -> D : update(id, data)
  D -> DB : UPDATE danh mục SET ... WHERE id=?
  D --> B : ok
  B --> V : thành công
  V --> U : "Sửa danh mục thành công"
else Không hợp lệ
  B --> V : lỗi
  V --> U : "Thông tin không hợp lệ"
end
deactivate B
deactivate V

@enduml
