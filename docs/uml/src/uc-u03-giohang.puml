@startuml uc-u03-giohang
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý giỏ hàng (UC03)
actor "Khách hàng" as ACT0
rectangle "Quản lý giỏ hàng" {
  usecase "Thêm vào giỏ" as U0
  usecase "Sửa số lượng" as U1
  usecase "Xóa khỏi giỏ" as U2
  usecase "Đặt hàng" as U3
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
@enduml
