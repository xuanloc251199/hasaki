@startuml sq-40-manage-danhmuc
title Biểu đồ tuần tự - Quản lý danh mục
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #FF5E8E
  ParticipantBorderColor #FF5E8E
  ParticipantBackgroundColor #FFF0F3
}
actor "Nhân viên" as U
participant "admin/categories.php" as V
participant "CategoryBLL" as B
participant "CategoryDAL" as D
database "CSDL" as DB
U -> V : Chọn chức năng quản lý danh mục
activate V
V -> B : getAll()
activate B
B -> D : getAll()
D -> DB : SELECT danh sách danh mục
DB --> D : dữ liệu
D --> B : danh sách
B --> V : danh sách
deactivate B
V --> U : Hiển thị danh sách danh mục
deactivate V

@enduml
