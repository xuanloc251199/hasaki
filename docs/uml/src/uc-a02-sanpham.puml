@startuml uc-a02-sanpham
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý sản phẩm (UC02)
actor "Nhân viên" as ACT0
rectangle "Quản lý sản phẩm" {
  usecase "Thêm sản phẩm" as U0
  usecase "Sửa sản phẩm" as U1
  usecase "Xóa sản phẩm" as U2
  usecase "Tìm kiếm sản phẩm" as U3
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
@enduml
