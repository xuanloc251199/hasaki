@startuml uc-a10-chatbot
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý AI Chatbot (UC10)
actor "Admin" as ACT0
rectangle "Quản lý AI Chatbot" {
  usecase "Thêm intent" as U0
  usecase "Sửa intent" as U1
  usecase "Xóa intent" as U2
  usecase "Bật/tắt intent" as U3
  usecase "Cấu hình chatbot" as U4
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
ACT0 -- U4
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
U4 ..> LOGIN : <<include>>
@enduml
