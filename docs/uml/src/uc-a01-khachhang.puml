@startuml uc-a01-khachhang
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF0F3
  BorderColor #FF5E8E
  ArrowColor #444444
}
title Use case chi tiết - Quản lý khách hàng (UC01)
actor "Nhân viên" as ACT0
rectangle "Quản lý khách hàng" {
  usecase "Thêm khách hàng" as U0
  usecase "Sửa khách hàng" as U1
  usecase "Xóa khách hàng" as U2
  usecase "Tìm kiếm khách hàng" as U3
  usecase "Đăng nhập" as LOGIN
}
ACT0 -- U0
ACT0 -- U1
ACT0 -- U2
ACT0 -- U3
U0 ..> LOGIN : <<include>>
U1 ..> LOGIN : <<include>>
U2 ..> LOGIN : <<include>>
U3 ..> LOGIN : <<include>>
@enduml
