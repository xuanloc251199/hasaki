# Hasaki - serve public/ as web root via mod_rewrite (Apache/Laragon)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/hasaki/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct access to non-public folders
RedirectMatch 404 ^/hasaki/(config|src|database)/.*$
